{
  "name": "ganh-hang-duong-pho",
  "version": "0.1.0",
  "description": "Gánh Hàng Đường Phố — Street Food Survival. Game 3D góc nhìn thứ nhất: sinh tồn đường phố, nấu ăn và buôn bán.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vitest run && vite build --outDir docs --emptyOutDir",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/baloo-2": "5.3.0",
    "@fontsource/patrick-hand": "5.3.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/three": "0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "homepage": "https://kietbuithui-coder.github.io/CookingGamebyShapi/",
  "repository": {
    "type": "git",
    "url": "https://github.com/kietbuithui-coder/CookingGamebyShapi.git"
  }
}
